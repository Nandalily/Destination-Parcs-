<form class="ad-edit" method="post" action="/admin/gallery" data-dirty-guard>
  <input type="hidden" name="_csrf" value="<%= csrf %>">
  <div class="ad-edit__main">
    <section class="ad-card">
      <h2>Gallery page</h2>
      <%- include('repeater', { prefix: 'albums', rows: albums, row: 'rows/album', blank: { name: '', items: [] }, addLabel: 'Add an album' }) %>
    </section>
  </div>
  <aside class="ad-edit__side"><div class="ad-card ad-sticky">
    <h2>Publish</h2>
    <button class="btn btn--leaf btn--block" type="submit"><%- icon('check') %>Save</button>
    <a class="btn btn--light-outline btn--block" href="/gallery" target="_blank" rel="noopener">View the gallery</a>
  </div></aside>
</form>
