<div class="rep__ctl">
  <button type="button" class="ad-icon" data-rep-up aria-label="Move up" title="Move up"><%- icon('chevron-left', 'rot90') %></button>
  <button type="button" class="ad-icon" data-rep-down aria-label="Move down" title="Move down"><%- icon('chevron-right', 'rot90') %></button>
  <button type="button" class="ad-icon ad-icon--danger" data-rep-remove aria-label="Remove" title="Remove"><%- icon('trash') %></button>
</div>
