<form class="ad-edit" method="post" action="/admin/pictures" data-dirty-guard>
  <input type="hidden" name="_csrf" value="<%= csrf %>">
  <div class="ad-edit__main">
    <% groups.forEach(function (g) { %>
      <section class="ad-card">
        <h2><%= g.label %> <span class="muted">(<%= g.rows.length %>)</span></h2>
        <% if (!g.rows.length) { %><p class="muted">Nothing here yet.</p><% } %>
        <div class="grid2">
          <% g.rows.forEach(function (r) { %><%- include('../partials/admin-media-field', { name: 'pic[' + r.id + ']', mode: 'image', label: r.name, value: r.value }) %><% }) %>
        </div>
      </section>
    <% }) %>
  </div>
  <aside class="ad-edit__side"><div class="ad-card ad-sticky"><h2>Publish</h2><button class="btn btn--leaf btn--block" type="submit"><%- icon('check') %>Save pictures</button></div></aside>
</form>
