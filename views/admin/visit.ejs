<% const ft = p.firstTime, ex = p.experience, ac = p.accessibility; %>
<form class="ad-edit" method="post" action="/admin/visit" data-dirty-guard>
  <input type="hidden" name="_csrf" value="<%= csrf %>">
  <div class="ad-edit__main">
    <section class="ad-card">
      <h2>First time here</h2>
      <label class="f"><span>Opening hours</span><textarea name="hours" rows="2" maxlength="400"><%= ft.hours || '' %></textarea></label>
      <label class="f"><span>How to get there (one step per line)</span><textarea name="getThere" rows="4"><%= (ft.getThere || []).join('\n') %></textarea></label>
      <label class="f"><span>What to bring (one per line)</span><textarea name="bring" rows="5"><%= (ft.bring || []).join('\n') %></textarea></label>
      <label class="f"><span>What to expect (one per line)</span><textarea name="expect" rows="5"><%= (ft.expect || []).join('\n') %></textarea></label>
      <label class="f"><span>Safety (one per line)</span><textarea name="safety" rows="5"><%= (ft.safety || []).join('\n') %></textarea></label>
    </section>
    <section class="ad-card">
      <h2>Frequently asked questions</h2>
      <%- include('repeater', { prefix: 'faqs', rows: ft.faqs || [], row: 'rows/pair', blank: {}, addLabel: 'Add a question', extra: { ka: 'q', kb: 'a', la: 'Question', lb: 'Answer', long: true } }) %>
    </section>
    <section class="ad-card">
      <h2>The D.P Experience</h2>
      <label class="f"><span>Our story (blank line between paragraphs)</span><textarea name="story" rows="8"><%= (ex.story || []).join('\n\n') %></textarea></label>
      <h3>Pillars</h3>
      <%- include('repeater', { prefix: 'pillars', rows: ex.pillars || [], row: 'rows/pair', blank: {}, addLabel: 'Add a pillar', extra: { ka: 'title', kb: 'text', la: 'Title', lb: 'Text' } }) %>
    </section>
    <section class="ad-card">
      <h2>Accessibility</h2>
      <label class="f"><span>Introduction</span><textarea name="accIntro" rows="3"><%= ac.intro || '' %></textarea></label>
      <%- include('repeater', { prefix: 'accSections', rows: ac.sections || [], row: 'rows/pair', blank: {}, addLabel: 'Add a section', extra: { ka: 'title', kb: 'text', la: 'Heading', lb: 'Details', long: true } }) %>
    </section>
  </div>
  <aside class="ad-edit__side"><div class="ad-card ad-sticky">
    <h2>Publish</h2>
    <button class="btn btn--leaf btn--block" type="submit"><%- icon('check') %>Save</button>
    <a class="btn btn--light-outline btn--block" href="/plan-your-visit/first-time" target="_blank" rel="noopener">View the page</a>
  </div></aside>
</form>
