<%- include('../partials/page-hero', { title: 'Contact & Directions', eyebrow: 'Plan Your Visit', crumbs: [['Plan Your Visit', '/plan-your-visit'], ['Contact & Directions']] }) %>
<section class="section"><div class="container two-col">
  <div>
    <p class="eyebrow">Find us</p><h2>The Farm, Katuulo</h2>
    <ul class="contact-list">
      <li><%- icon('map-pin') %><span><strong>Address</strong><%= site.contact.address %></span></li>
      <% if (site.contact.phone) { %><li><%- icon('phone') %><span><strong>Phone</strong><% if (site.contact.phone) { %><a href="tel:<%= site.contact.phone.replace(/\s/g,'') %>"><%= site.contact.phone %></a><% } %></span></li><% } %>
      <li><%- icon('mail') %><span><strong>Email</strong><% if (site.contact.email) { %><a href="mailto:<%= site.contact.email %>"><%= site.contact.email %></a><% } else { %>Use the form to reach us<% } %></span></li>
      <li><%- icon('clock') %><span><strong>Opening hours</strong><%= site.contact.hours || 'To be confirmed. Please contact us before travelling.' %></span></li>
    </ul>
    <p class="btn-row"><a class="btn btn--leaf" target="_blank" rel="noopener" href="https://www.google.com/maps/search/?api=1&amp;query=<%= encodeURIComponent(site.mapSearchQuery) %>">Open in maps</a></p>
    <% if (site.mapEmbed.lat && site.mapEmbed.lng) { %>
      <iframe class="map-embed" title="Map of The Farm" loading="lazy" src="https://www.openstreetmap.org/export/embed.html?bbox=<%= site.mapEmbed.lng - 0.02 %>%2C<%= site.mapEmbed.lat - 0.012 %>%2C<%= site.mapEmbed.lng + 0.02 %>%2C<%= site.mapEmbed.lat + 0.012 %>&amp;layer=mapnik&amp;marker=<%= site.mapEmbed.lat %>%2C<%= site.mapEmbed.lng %>"></iframe>
    <% } %>
    <h3>Directions</h3>
    <p>The Farm is in Katuulo, along Bujuuko-Mityana Road. Look for the Destination Parcs signboard at the entrance.</p>
  </div>
  <div><h2>Send us a message</h2><%- include('../partials/enquiry', { topic: 'Contact page', back: '/plan-your-visit/contact' }) %></div>
</div></section>
