<%- include('../partials/page-hero', { title: 'Weddings & Celebrations', eyebrow: 'Corporate & Events', crumbs: [['Corporate & Events', '/corporate'], ['Weddings & Celebrations']], image: media.page('weddings') }) %>
<section class="section"><div class="container">
  <div class="grid grid--3">
    <% items.forEach(function (e) { %>
      <article class="panel"><span class="panel__icon"><%- icon('heart') %></span><h2><%= e.name %></h2><p><%= e.involves %></p><h3>We plan for</h3><p class="muted"><%= e.requirements %></p></article>
    <% }) %>
  </div>
  <div class="callout block"><%- icon('gift') %><div><h3>Wedding Breaks</h3><p>Venue, accommodation, photo sessions and celebrations bundled together.</p></div><a class="btn btn--leaf" href="/breaks/wedding-breaks">See the break</a></div>
  <p class="btn-row"><a class="btn btn--gold" href="/corporate/quote">Request a quote</a></p>
</div></section>
