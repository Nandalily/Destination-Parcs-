<%- include('../partials/page-hero', { title: 'My trip', eyebrow: 'Your shortlist', crumbs: [['My trip']] }) %>
<section class="section"><div class="container">
  <% if (items.length) { %>
    <div class="grid grid--3"><% items.forEach(function (a) { %><%- include('../partials/activity-card', { a: a }) %><% }) %></div>
    <div class="btn-row block">
      <a class="btn btn--gold btn--lg" href="/book">Book this trip</a>
      <form method="post" action="/trip/clear"><input type="hidden" name="_csrf" value="<%= csrf %>"><button class="btn btn--ghost btn--lg" type="submit">Clear my trip</button></form>
      <a class="btn btn--ghost btn--lg" href="/things-to-do">Add more</a>
    </div>
  <% } else { %>
    <div class="empty"><%- icon('bookmark') %><h2>Your trip is empty</h2><a class="btn btn--leaf" href="/things-to-do">Browse activities</a></div>
  <% } %>
</div></section>
