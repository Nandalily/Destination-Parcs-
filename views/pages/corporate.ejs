<%- include('../partials/page-hero', { title: 'Corporate & Events', eyebrow: 'Work, together', crumbs: [['Corporate & Events']], image: media.page('corporate'), tone: 'forest' }) %>
<section class="section"><div class="container">
  <div class="grid grid--3 corp-cards">
    <% hubCards('corporate').forEach(function (c) { %>
      <%- include('../partials/hub-card', { c: c, more: 'Explore' }) %>
    <% }) %>
  </div>
</div></section>
<section class="section section--tint curve-top"><div class="container two-col">
  <div>
    <p class="eyebrow">Why The Farm</p><h2>Step out of the office, think clearer</h2>
    <ul class="ticks">
      <li><%- icon('check') %>Quiet spaces for deep work and private strategy sessions</li>
      <li><%- icon('check') %>Activity programmes that match your goals and timing</li>
      <li><%- icon('check') %>Accommodation, meals and parking handled in one booking</li>
      <li><%- icon('check') %>Safety briefings and trained guides at every activity</li>
    </ul>
  </div>
  <div class="callout callout--stack"><%- icon('briefcase') %><h3>Planning an event?</h3><p>Tell us your group size and dates. We will send a tailored quote.</p><a class="btn btn--gold" href="/corporate/quote">Request a quote</a></div>
</div></section>
