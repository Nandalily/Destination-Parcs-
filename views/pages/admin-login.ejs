<main class="admin-login"><form class="form form--card" method="post" action="/admin/login">
  <img src="/images/brand/logo-full.png" alt="Destination Parcs" width="260" height="132">
  <h1>Team sign in</h1>
  <input type="hidden" name="_csrf" value="<%= csrf %>">
  <label>Password<input name="password" type="password" required autofocus></label>
  <button class="btn btn--leaf btn--block" type="submit">Sign in</button>
</form></main>
