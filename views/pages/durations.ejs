<%- include('../partials/page-hero', { title: 'Break Durations', eyebrow: 'Breaks & Packages', crumbs: [['Breaks & Packages', '/breaks'], ['Break Durations']] }) %>
<section class="section"><div class="container narrow-wide">
  <div class="dur-list">
    <% durations.forEach(function (x) { %>
      <article class="dur" id="<%= x.slug %>">
        <div class="dur__len"><strong><%= x.length %></strong></div>
        <div><h2><%= x.name %></h2><p><%= x.use %></p></div>
        <a class="link-arrow" href="/book?duration=<%= x.slug %>">Book <%- icon('arrow-right') %></a>
      </article>
    <% }) %>
  </div>
</div></section>
