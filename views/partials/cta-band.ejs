<%# params: title, text, primary [label, href], secondary? [label, href] %>
<section class="cta-band">
  <div class="container cta-band__inner">
    <div><h2><%= title %></h2><p><%= text %></p></div>
    <div class="cta-band__actions">
      <a class="btn btn--gold" href="<%= primary[1] %>"><%= primary[0] %></a>
    </div>
  </div>
</section>
