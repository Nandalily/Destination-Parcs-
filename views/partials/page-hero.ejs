<%# params: title, eyebrow?, lead?, crumbs? [[label, href]], image?, tone?  The admin can override heading, intro and picture per page (Page headers). %>
<%
  const _o = ((data && data.pages && data.pages.heroes) || {})[typeof pageKey !== 'undefined' ? pageKey : ''] || {};
  const _title = _o.title || title;
  const _eyebrow = _o.eyebrow || (typeof eyebrow !== 'undefined' ? eyebrow : '');
  const _lead = _o.lead || (typeof lead !== 'undefined' ? lead : '');
  const _image = _o.image || (typeof image !== 'undefined' ? image : '');
%>
<section class="page-hero <%= _image ? 'has-image' : '' %> tone-<%= typeof tone !== 'undefined' ? tone : 'forest' %>">
  <% if (_image) { %><img class="page-hero__img" src="<%= _image %>" alt=""><% } %>
  <div class="page-hero__shade"></div>
  <span class="page-hero__leaf" aria-hidden="true"></span>
  <div class="container page-hero__inner">
    <% if (_eyebrow) { %><p class="eyebrow eyebrow--gold"><%= _eyebrow %></p><% } %>
    <h1><%= _title %></h1>
    <% if (_lead) { %><p class="lead"><%= _lead %></p><% } %>
  </div>
  <svg class="page-hero__curve" viewBox="0 0 1440 48" preserveAspectRatio="none" aria-hidden="true"><path d="M0 48V20C300 -10 620 -6 900 18s380 20 540 0V48Z"/></svg>
</section>
