PORT=3000
BASE_URL=https://www.your-domain.com
SESSION_SECRET=change-me-to-a-long-random-string
ADMIN_PASSWORD=choose-a-strong-password
NODE_ENV=production
# Optional
# MAX_VIDEO_MB=300
# MAX_IMAGE_MB=25
# STORAGE_DIR=/var/lib/destination-parcs/storage

# ---- Database (optional). Leave these out to keep using JSON files in /storage.
# On cPanel: MySQL Databases -> create a database, a user, and add the user to the database with All Privileges.
# cPanel prefixes names, for example myaccount_dparcs and myaccount_dpuser.
# DB_HOST=localhost
# DB_PORT=3306
# DB_NAME=myaccount_dparcs
# DB_USER=myaccount_dpuser
# DB_PASSWORD=the-password-you-set
# DB_PREFIX=dp_
# or one line instead: DATABASE_URL=mysql://user:password@localhost:3306/dbname
# Team area sign-in length (defaults shown): signed out after 30 minutes without activity, and after 8 hours in total
# ADMIN_IDLE_MINUTES=30
# ADMIN_MAX_HOURS=8
